# Generated on-chain art assets: integrity is enforced by sha256 in
# Traits/index.json + extract-traits.js --verify and the held-out
# byte-parity validation, not by eyeball review. Suppressing diffs
# keeps PR reviews focused on the reviewable surface.
/Traits/** -diff
/Tools/data/hashes.json -diff
/Tools/data/ub.json -diff
/Tools/data/burned.json -diff

# Vendored third-party libraries (never edited in-repo): diffs are
# noise and large enough to crash panel reviewers.
/Lib/vendor/** -diff
/Tools/data/vrm-manifest.json -diff
